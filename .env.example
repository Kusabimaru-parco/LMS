# Copy to .env for local development. Production installers write .env for you:
#   Linux: ./install.sh · Windows: install-windows.cmd · Vercel/Supabase: npm run setup:baas
# See docs/INSTALL.md for every option.

# PostgreSQL connection string. For local dev, `npm run db:local` provides this one:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/campus_lms"

# 32+ random characters, e.g. `openssl rand -base64 48`. Signs sessions and encrypts stored secrets.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-in-production"

# Optional: fixed code for the /setup wizard. If empty, one is generated and printed in the server logs.
# SETUP_CODE=""

# Recommended in production: public address of the site.
# APP_URL="https://lms.yourschool.edu"

# true = one-click demo sign-in buttons (sales demos only). Never enable it for a real school.
DEMO_MODE="false"

# ---- Uploaded files -------------------------------------------------------------------------
# "local" (default): files on this server's disk in UPLOAD_DIR. "s3": any S3-compatible bucket
# (Supabase Storage, Cloudflare R2, AWS S3, MinIO). Use s3 on Vercel and other serverless hosts.
# STORAGE_DRIVER="local"
# UPLOAD_DIR="/var/lib/campus-lms/uploads"
# S3_ENDPOINT="https://<project>.supabase.co/storage/v1/s3"
# S3_REGION="auto"
# S3_BUCKET="campus-lms"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Largest file a teacher or student can upload, in MB (default 50; 4 on Vercel).
# MAX_UPLOAD_MB="50"

# ---- Background jobs (reminders, weekly parent summaries) -----------------------------------
# Self-hosted installs run them every 15 minutes by themselves. On Vercel, set CRON_SECRET; Vercel
# then calls /api/cron on the schedule in vercel.json.
# CRON_SECRET=""
# DISABLE_JOBS="false"

# ---- Updates --------------------------------------------------------------------------------
# Where to check for new versions (a latest.json published with each release). Empty = off.
# UPDATE_FEED_URL="https://downloads.example.com/campus-lms/latest.json"
