{
  "name": "campus-lms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "demo": "prisma migrate deploy && node prisma/seed.mjs",
    "vercel-build": "prisma generate && DATABASE_URL=\"${MIGRATE_DATABASE_URL:-$DATABASE_URL}\" prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "setup:baas": "node scripts/setup-baas.mjs",
    "release": "bash scripts/package-release.sh"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.17",
    "lucide-react": "0.511.0",
    "next": "15.5.29",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "6.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    }
  }
}
